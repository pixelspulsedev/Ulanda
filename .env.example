# ULANDA — environment variables
# Copy to .env.local and fill in real values. Never commit real IDs.

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# When set, src/lib/analytics.js loads GTM after Consent Mode defaults are applied.
VITE_GTM_ID=

# Configure GA4 + Meta Pixel inside the GTM container itself.
# These are listed here only for reference / future server-side use.
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXX
# VITE_META_PIXEL_ID=000000000000000

# reCAPTCHA v3 site key used by contact / booking forms.
VITE_RECAPTCHA_SITE_KEY=
