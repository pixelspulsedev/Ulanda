{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/treatments/radiate/programmes/:path*",
      "destination": "/treatments/radiate/pathways/:path*",
      "permanent": true
    },
    {
      "source": "/treatments/radiate/programmes",
      "destination": "/treatments/radiate/pathways",
      "permanent": true
    },
    {
      "source": "/conditions/skin-laxity",
      "destination": "/conditions/menopause-hormone-skin-changes",
      "permanent": true
    },
    {
      "source": "/conditions/dark-circles",
      "destination": "/conditions/eye-area/dark-circles",
      "permanent": true
    },
    {
      "source": "/conditions/post-inflammatory-hyperpigmentation",
      "destination": "/conditions/pigmentation-and-skin-tone/post-inflammatory-hyperpigmentation",
      "permanent": true
    },
    {
      "source": "/conditions/skin-texture-quality",
      "destination": "/conditions/age-and-regeneration",
      "permanent": true
    },
    {
      "source": "/conditions/body-skin-concerns/:path*",
      "destination": "/conditions/body-skin-structural/:path*",
      "permanent": true
    },
    {
      "source": "/conditions/body-skin-concerns",
      "destination": "/conditions/body-skin-structural",
      "permanent": true
    },
    {
      "source": "/conditions/wellness-life-stage/:path*",
      "destination": "/conditions/internal-wellness/:path*",
      "permanent": true
    },
    {
      "source": "/programmes/menopause-regeneration",
      "destination": "/treatments/radiate/pathways/menopause-regeneration",
      "permanent": true
    },
    {
      "source": "/programmes/under-eye-regeneration",
      "destination": "/treatments/radiate/pathways/under-eye-regeneration",
      "permanent": true
    },
    {
      "source": "/programmes/collagen-reset",
      "destination": "/treatments/radiate/pathways/collagen-reset",
      "permanent": true
    },
    {
      "source": "/programmes/hormone-smart-skin",
      "destination": "/treatments/radiate/pathways/hormone-smart-skin",
      "permanent": true
    },
    {
      "source": "/programmes/shape-and-regenerate",
      "destination": "/treatments/radiate/pathways/shape-and-regenerate",
      "permanent": true
    },
    {
      "source": "/programmes/:path*",
      "destination": "/treatments/radiate/pathways",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
